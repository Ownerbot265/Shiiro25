* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #fbfaff;
    color: #211b35;
}

/* NAVBAR */

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background: white;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 15px #00000008;
}

.logo {
    font-size: 27px;
    font-weight: 900;
    color: #211b35;
    text-decoration: none;
}

.logo span,
footer span {
    color: #8561ed;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    text-decoration: none;
    color: #777;
    font-size: 14px;
    font-weight: 600;
    transition: .3s;
}

nav a:hover {
    color: #8561ed;
}

.login-btn {
    padding: 11px 18px;
    background: white;
    border: 1px solid #e7e1f5;
    border-radius: 10px;
    cursor: pointer;
    font-weight: bold;
}

/* HERO */

.hero {
    min-height: 540px;
    padding: 80px 9%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background:
        radial-gradient(circle at 80% 30%, #e8dfff, transparent 35%),
        #fbfaff;
}

.hero-content {
    max-width: 550px;
}

.tag,
.section-title span {
    color: #8561ed;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
}

.hero h1 {
    font-size: clamp(40px, 5vw, 65px);
    line-height: 1.15;
    margin: 20px 0;
}

.hero h1 span {
    color: #8561ed;
}

.hero p {
    color: #858095;
    line-height: 1.8;
    max-width: 450px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.btn-primary,
.btn-secondary {
    padding: 14px 22px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: bold;
    font-size: 13px;
    transition: .3s;
}

.btn-primary {
    background: #8561ed;
    color: white;
}

.btn-secondary {
    background: white;
    color: #8561ed;
    border: 1px solid #e7e1f5;
}

.btn-primary:hover,
.btn-secondary:hover {
    transform: translateY(-4px);
}

/* HERO IMAGE */

.hero-image {
    position: relative;
    width: 330px;
    height: 330px;
    display: grid;
    place-items: center;
}

.circle {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, #d9c9ff, #9270ee);
    position: absolute;
    box-shadow: 0 20px 60px #8561ed40;
}

.hero-logo {
    position: relative;
    color: white;
    font-size: 170px;
    font-weight: 900;
    text-shadow: 0 10px 25px #3b267d55;
}

.floating-card {
    position: absolute;
    bottom: 35px;
    right: -15px;
    background: white;
    padding: 13px 18px;
    border-radius: 12px;
    font-weight: bold;
    font-size: 11px;
    box-shadow: 0 10px 30px #00000012;
}

/* STATS */

.stats {
    display: flex;
    justify-content: center;
    gap: 100px;
    padding: 25px;
    background: white;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
}

.stats div {
    display: flex;
    align-items: center;
    gap: 12px;
}

.stats h2 {
    color: #8561ed;
    font-size: 20px;
}

.stats p {
    color: #777;
    font-size: 13px;
}

/* SECTION */

.section {
    padding: 85px 8%;
}

.section-title {
    text-align: center;
    margin-bottom: 35px;
}

.section-title h2 {
    font-size: 35px;
    margin: 10px 0;
}

.section-title p {
    color: #888;
    font-size: 14px;
}

/* SEARCH */

#search {
    display: block;
    width: 100%;
    max-width: 400px;
    padding: 13px 17px;
    border: 1px solid #e8e2f4;
    border-radius: 10px;
    margin: 0 auto 30px;
    outline: none;
}

#search:focus {
    border-color: #8561ed;
}

/* PRODUCT */

.products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.product {
    background: white;
    border: 1px solid #eeeaf6;
    border-radius: 16px;
    padding: 15px;
    transition: .3s;
}

.product:hover {
    transform: translateY(-7px);
    box-shadow: 0 15px 35px #8561ed18;
}

.product-img {
    height: 150px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: white;
    font-size: 40px;
    font-weight: 900;
    margin-bottom: 15px;
}

.ml {
    background: linear-gradient(135deg, #183a76, #6794ed);
}

.gi {
    background: linear-gradient(135deg, #26776b, #85d8b6);
}

.hsr {
    background: linear-gradient(135deg, #41316c, #a98aff);
}

.roblox {
    background: linear-gradient(135deg, #35394f, #929bb8);
}

.product h3 {
    font-size: 16px;
    margin-bottom: 5px;
}

.product p {
    color: #888;
    font-size: 12px;
    margin-bottom: 12px;
}

.product h4 {
    color: #8561ed;
    margin-bottom: 13px;
}

.product button {
    width: 100%;
    border: none;
    background: #8561ed;
    color: white;
    padding: 11px;
    border-radius: 9px;
    font-weight: bold;
    cursor: pointer;
    transition: .3s;
}

.product button:hover {
    background: #6844d2;
}

.diamond {
    height: 100px;
    display: grid;
    place-items: center;
    background: #f1ecff;
    color: #8561ed;
    font-size: 45px;
    border-radius: 12px;
    margin-bottom: 15px;
}

/* SELL ACCOUNT */

.sell-section {
    padding: 85px 8%;
    background: #f3efff;
}

.sell-section form {
    max-width: 550px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 18px;
    box-shadow: 0 10px 35px #8561ed12;
}

.sell-section input,
.sell-section select,
.sell-section textarea {
    width: 100%;
    padding: 13px;
    margin-bottom: 15px;
    border: 1px solid #e8e2f4;
    border-radius: 9px;
    outline: none;
    font-size: 13px;
}

.sell-section input:focus,
.sell-section select:focus,
.sell-section textarea:focus {
    border-color: #8561ed;
}

.sell-section textarea {
    resize: vertical;
    min-height: 100px;
}

.sell-section button {
    width: 100%;
    padding: 14px;
    background: #8561ed;
    color: white;
    border: none;
    border-radius: 9px;
    font-weight: bold;
    cursor: pointer;
}

/* FOOTER */

footer {
    background: #211b35;
    color: white;
    text-align: center;
    padding: 35px 15px;
}

footer h2 {
    font-size: 27px;
    margin-bottom: 10px;
}

footer p {
    color: #aaa2c1;
    font-size: 12px;
    margin-top: 5px;
}

/* RESPONSIVE */

@media(max-width: 900px) {
    .products {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        padding: 60px 6%;
    }

    .stats {
        gap: 35px;
    }
}

@media(max-width: 600px) {
    header {
        padding: 15px 5%;
        flex-wrap: wrap;
        gap: 15px;
    }

    nav {
        order: 3;
        width: 100%;
        justify-content: space-between;
        gap: 8px;
    }

    nav a {
        font-size: 11px;
    }

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero p {
        margin: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image {
        transform: scale(.85);
        margin-top: 25px;
    }

    .stats {
        gap: 15px;
        justify-content: space-around;
    }

    .stats div {
        flex-direction: column;
        gap: 3px;
    }

    .stats p {
        font-size: 10px;
    }

    .section {
        padding: 60px 5%;
    }

    .section-title h2 {
        font-size: 28px;
    }

    .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .product-img {
        height: 110px;
    }

    .product {
        padding: 10px;
    }

    .product h3 {
        font-size: 13px;
    }

    .product p {
        font-size: 10px;
    }

    .sell-section {
        padding: 60px 5%;
    }

    .sell-section form {
        padding: 20px;
    }
}